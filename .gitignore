# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# secrets — defense in depth (copied from .env.local for prisma migrate to pick up)
.env

# Pilot practitioner data (real PII — names/emails/bios). Local-only; the importer
# seeds the DB from here. Source xlsx + LLM-normalized JSON live here, never committed.
amy-assets/

# Playwright MCP session traces (smoke-test artifacts, not project content)
.playwright-mcp/

# Smoke-test screenshots at repo root — keep committed images in public/ or docs/
/*.png
.env.typescript
.env*
taglines-proposal.json

# Claude Code local scratch — agent worktrees, local settings. Never project content.
# A `git add -A` would otherwise stage .claude/worktrees/* as an embedded gitlink
# (a broken submodule ref that clones cannot resolve).
.claude/

# Session handoff scaffolding. Local-only for the same reason as amy-assets/:
# these discuss named individuals and carry their email addresses, and this repo
# is PUBLIC. tc-draft.md is the deliberate exception — it is committed because
# TermsAcknowledgment.tsx's doc comment references it (PR #93).
_HANDOFF_*.md
_handoff-context/*
!_handoff-context/tc-draft.md
